{
    "configurations": [
        {
            "name": "ArduinoRaven",
            "compilerPath": "${PROGRAMFILES(X86)}/Arduino/hardware/tools/avr/bin/avr-g++",
            "compilerArgs": [
                "-w",
                "-std=c++11",
                "-fpermissive",
                "-fno-exceptions",
                "-ffunction-sections",
                "-fdata-sections",
                "-fno-threadsafe-statics",
                "-Wno-error=narrowing"
            ],
            "intelliSenseMode": "gcc-x64",
            "includePath": [
                "${workspaceFolder}/**",
                "${env:ProgramFiles(x86)}/Arduino/hardware/arduino/avr/cores/arduino/**",
                "${env:ProgramFiles(x86)}/Arduino/hardware/arduino/avr/variants/**",
                "${env:ProgramFiles(x86)}/Arduino/hardware/tools/avr/lib/gcc/avr/**",
                "${env:ProgramFiles(x86)}/Arduino/hardware/tools/avr/avr/include/**",
                "${env:ProgramFiles(x86)}/Arduino/hardware/arduino/avr/libraries/**",
                "${env:ProgramFiles(x86)}/Arduino/libraries/**",
                "${env:LOCALAPPDATA}/Arduino15/packages/arduino/hardware/avr/**",
                "${env:LOCALAPPDATA}/Arduino15/packages/arduino/hardware/megaavr/**",
                "${env:LOCALAPPDATA}/Arduino15/packages/arduino/hardware/sam/**",
                "${env:LOCALAPPDATA}/Arduino15/packages/arduino/hardware/samd/**",
                "${env:LOCALAPPDATA}/Arduino15/packages/arduino/hardware/mbed_nano/**",
                "${env:LOCALAPPDATA}/Arduino15/packages/arduino/hardware/mbed_portenta/**",
                "${env:LOCALAPPDATA}/Arduino15/packages/esp8266/hardware/esp8266/**",
                "${env:LOCALAPPDATA}/Arduino15/packages/esp32/hardware/esp32/**",
                "${env:LOCALAPPDATA}/Arduino15/packages/STMicroelectronics/hardware/stm32/**",
                "${env:LOCALAPPDATA}/Arduino15/packages/arduino/tools/avr-gcc/**",
                "${env:LOCALAPPDATA}/Arduino15/packages/esp8266/tools/**",
                "${env:LOCALAPPDATA}/Arduino15/packages/esp32/tools/**",
                "${env:ProgramFiles(x86)}/Arduino/hardware/teensy/avr/cores/**",
                "${env:ProgramFiles(x86)}/Arduino/hardware/teensy/avr/libraries/**",
                "${env:USERPROFILE}/Documents/Arduino/libraries/**"
            ],
            "defines": [
                "__cplusplus",
                "_DEBUG",
                "UNICODE",
                "_UNICODE",
                "ARDUINO=100",
                "F_CPU=16000000",
                "LEPFLIR_ENABLE_DEBUG_OUTPUT"
            ],
            "cStandard": "c11",
            "cppStandard": "c++11",
            "forcedInclude": []
        }
    ],
    "version": 4
}